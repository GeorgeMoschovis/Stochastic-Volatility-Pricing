# Dark theme shared by every README figure (same colours as the web app)
figure.facecolor: 0b1220
savefig.facecolor: 0b1220
axes.facecolor: 111a2e
axes.edgecolor: 2a3a5c
axes.labelcolor: a9b4c9
axes.titlecolor: e6ebf5
text.color: e6ebf5
xtick.color: 8b97b0
ytick.color: 8b97b0
axes.grid: True
grid.color: 1e2a44
grid.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['3987e5', 'd95926', '199e70', 'c98500', 'd55181'])
font.family: sans-serif
font.size: 10
axes.titlesize: 11
axes.titleweight: bold
legend.frameon: False
lines.linewidth: 2
savefig.dpi: 160
savefig.bbox: tight
